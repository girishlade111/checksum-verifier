# ---------------------------------------------------------------------------
# CodeBuddy Agent SDK credentials (only needed for the built-in Assistant)
# ---------------------------------------------------------------------------
# The checksum engine itself is 100% client-side and needs no configuration at all.
# These variables are read by `server/index.ts`; copy this file to `.env` to use them.

# Personal access key from https://www.codebuddy.cn
CODEBUDDY_API_KEY=

# Alternatively authenticate with a token instead of an API key.
CODEBUDDY_AUTH_TOKEN=

# Optional overrides
# CODEBUDDY_BASE_URL=https://api.codebuddy.cn
# CODEBUDDY_INTERNET_ENVIRONMENT=external

# Port for the Express Agent API (Vite proxies /api -> http://localhost:3001)
# PORT=3001
