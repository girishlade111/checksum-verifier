{
  "name": "checksum-verifier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "100% client-side file integrity verifier (MD5 / SHA-1 / SHA-256 / SHA-512) with an embedded CodeBuddy Agent SDK assistant, runnable in the browser or as an Electron desktop app.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:electron": "concurrently -k -n server,web,electron -c magenta,cyan,blue \"npm:dev:server\" \"npm:dev:web\" \"npm:electron:wait\"",
    "electron:wait": "cross-env ELECTRON_DEV_URL=http://localhost:5173 wait-on tcp:5173 && electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:electron": "npm run build && electron .",
    "typecheck": "tsc -b",
    "typecheck:server": "tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:engine && npm run test:manifest && npm run test:pump",
    "test:engine": "node scripts/verify-engine.mjs",
    "test:manifest": "tsx scripts/verify-manifest.ts",
    "test:pump": "node scripts/repro-pump-closure.mjs",
    "test:e2e": "node scripts/e2e-pool.mjs && node scripts/e2e-ui.mjs",
    "test:e2e:pool": "node scripts/e2e-pool.mjs",
    "test:e2e:ui": "node scripts/e2e-ui.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tencent-ai/agent-sdk": "^0.3.43",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.17",
    "hash-wasm": "^4.11.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.3"
  }
}
